# memory | http
COMMERCE_BACKEND=memory
# Required when COMMERCE_BACKEND=http
COMMERCE_API_URL=https://api.example-store.test/v1
COMMERCE_API_TOKEN=
# Write tools (create_order, update_order_status, adjust_inventory) are disabled unless "true"
COMMERCE_ALLOW_WRITES=false
# Sales tax applied by the in-memory backend
COMMERCE_TAX_RATE=0.0825
